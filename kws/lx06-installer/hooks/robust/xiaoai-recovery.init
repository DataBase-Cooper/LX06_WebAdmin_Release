#!/bin/sh /etc/rc.common
# S71 xiaoai-recovery：官方语音栈崩溃监视 + 级联恢复（见 /usr/lib/lx06/xiaoai-recovery.sh）。
# 排在 S70 lx06-watchdog 之后；只管 pns/media 系/mico_aivs_lab，绝不 reboot。
# 与 S70 分工：S70 管 88/89 整机瘫痪（reboot -f），本服务管语音栈瘫痪（级联重启）。
# 自身崩溃由 procd respawn 拉起（30 5 5）。
START=71
STOP=9
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/lib/lx06/xiaoai-recovery.sh
    procd_set_param respawn 30 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
