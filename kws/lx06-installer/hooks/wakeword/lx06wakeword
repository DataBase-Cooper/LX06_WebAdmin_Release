#!/bin/sh /etc/rc.common
# LX06 唤醒技能 · 常驻监听服务（脚本中心上方的「唤醒技能」固件侧）
# 音频共享：官方 DSP 输出的独立只读订阅；不改官方库或 ALSA 配置。
# 配置变更（加词/改阈值/链接/删录音重训）由 webd 调本脚本 restart 生效：
#   detect 管道参数在启动时定死，restart = 整条管道按新配置重建。
START=62
STOP=40
USE_PROCD=1

start_service() {
    # Local wake listening is on by default. This script must not create or
    # rewrite /data/wakeword/official_xiaoai; that switch is independent.
    # A stable instance name makes repeated start idempotent. A pgrep guard
    # can see the terminating old shell during restart and skip the new one.
    procd_open_instance local-kws
    procd_set_param command /usr/lib/lx06/wakeword/watch-ww.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd terminates the owning shell; its trap reaps only its own children.
    # Never close official audio, or kill another recording/script subscriber.
    return 0
}
