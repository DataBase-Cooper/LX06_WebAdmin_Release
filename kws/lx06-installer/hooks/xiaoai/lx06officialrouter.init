#!/bin/sh /etc/rc.common
# One official-ASR router shared by independently installed user scripts.
START=84
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/lib/lx06/xiaoai/official-router
    procd_set_param env GLIBC_TUNABLES=glibc.pthread.rseq=0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
